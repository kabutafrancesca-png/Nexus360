# =============================================================
#  Nexus 360 — environment variables
#  Copy this file to .env and fill in the values:
#      cp .env.example .env        (Mac/Linux)
#      copy .env.example .env      (Windows)
#
#  .env is git-ignored — never commit it.
#  .env.example is committed — keep it up to date when you
#  add a new variable.
# =============================================================


# -------------------------------------------------------------
# FLASK
# -------------------------------------------------------------

# Any long random string — used to sign session cookies.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production. The default "dev-secret" is fine for local dev only.
SECRET_KEY=


# -------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------

# Supabase / Postgres connection string.
# Leave this BLANK (or remove the line) to use the local SQLite file at
# db/nexus360_local.sqlite3 — no Postgres install needed.
#
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Find it in Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=


# -------------------------------------------------------------
# SUPABASE (only needed for file storage / edge functions)
# -------------------------------------------------------------

# Project URL — found in Supabase: Project Settings → API → Project URL
SUPABASE_URL=

# Anon/public key — found in Supabase: Project Settings → API → Project API keys
SUPABASE_KEY=


# -------------------------------------------------------------
# FILE UPLOADS
# -------------------------------------------------------------

# Local folder where uploaded PDFs/files are saved.
# Defaults to "uploads/" inside the project root if not set.
UPLOAD_DIR=uploads
