# =============================================================
#  Nexus 360 — environment variables template
#
#  Copy this file to .env and fill in your values:
#      copy .env.example .env       (Windows)
#      cp .env.example .env         (Mac / Linux)
#
#  .env is git-ignored — never commit it.
#  .env.example is committed — update it when adding new variables.
# =============================================================


# -------------------------------------------------------------
# FLASK
# Required. Any long random string used to sign session cookies.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -------------------------------------------------------------
SECRET_KEY=


# -------------------------------------------------------------
# DATABASE
# Leave blank to use local SQLite (db/nexus360_local.sqlite3).
# Fill in your Supabase connection string when ready.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Find it: Supabase → Project Settings → Database → URI
# -------------------------------------------------------------
DATABASE_URL=


# -------------------------------------------------------------
# SUPABASE (only needed for file storage / realtime features)
# Find these: Supabase → Project Settings → API
# -------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=


# -------------------------------------------------------------
# FILE UPLOADS
# Folder where uploaded PDFs are saved. Defaults to uploads/
# -------------------------------------------------------------
UPLOAD_DIR=uploads
